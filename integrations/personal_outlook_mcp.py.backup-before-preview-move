import atexit
import json
import os
import queue
import subprocess
import threading
from pathlib import Path


PROJECT_DIR = Path(r"E:\kaizumi\kaizumi")
WORKER = PROJECT_DIR / "integrations" / "personal_outlook_worker.py"
PYTHON312 = Path(r"E:\outlook-mcp-venv\Scripts\python.exe")

REQUEST_TIMEOUT = 180


class PersonalOutlookBridge:
    def __init__(self):
        self.process = None
        self.lock = threading.Lock()
        self.responses = queue.Queue()
        self.request_id = 0
        self.reader_thread = None

    def _read_stdout(self, process):
        try:
            for line in process.stdout:
                try:
                    self.responses.put(json.loads(line))
                except json.JSONDecodeError as exc:
                    self.responses.put({
                        "ok": False,
                        "error": f"Invalid worker JSON: {exc}"
                    })
        except Exception as exc:
            self.responses.put({
                "ok": False,
                "error": f"Worker output error: {exc}"
            })

        self.responses.put({
            "ok": False,
            "error": "Personal Outlook worker stopped."
        })

    def _start(self):
        if self.process and self.process.poll() is None:
            return

        if not PYTHON312.is_file():
            raise FileNotFoundError(
                f"Python 3.12 not found: {PYTHON312}"
            )

        if not WORKER.is_file():
            raise FileNotFoundError(
                f"Worker script not found: {WORKER}"
            )

        self.responses = queue.Queue()

        self.process = subprocess.Popen(
            [str(PYTHON312), "-u", str(WORKER)],
            cwd=str(PROJECT_DIR),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            bufsize=1,
            env={**os.environ.copy(), "PYTHONIOENCODING": "utf-8"},
        )

        self.reader_thread = threading.Thread(
            target=self._read_stdout,
            args=(self.process,),
            daemon=True,
            name="PersonalOutlookWorkerReader",
        )
        self.reader_thread.start()

    def _request(self, payload):
        with self.lock:
            self._start()

            self.request_id += 1
            request_id = self.request_id

            payload["id"] = request_id

            try:
                self.process.stdin.write(
                    json.dumps(payload, ensure_ascii=False) + "\n"
                )
                self.process.stdin.flush()
            except Exception as exc:
                self._stop()
                raise RuntimeError(
                    f"Could not communicate with Outlook worker: {exc}"
                ) from exc

            try:
                response = self.responses.get(
                    timeout=REQUEST_TIMEOUT
                )
            except queue.Empty:
                self._stop()
                raise TimeoutError(
                    "Personal Outlook worker timed out."
                )

            if response.get("id") != request_id:
                self._stop()
                raise RuntimeError(
                    "Personal Outlook worker returned an unexpected response."
                )

            if not response.get("ok"):
                raise RuntimeError(
                    response.get("error")
                    or response.get("content")
                    or "Personal Outlook operation failed."
                )

            return response

    def list_tools(self):
        response = self._request({
            "action": "list_tools"
        })
        return json.dumps(
            response.get("tools", []),
            ensure_ascii=False,
            indent=2,
        )

    def call_tool(self, tool_name, arguments):
        if not isinstance(arguments, dict):
            raise ValueError("arguments must be a dictionary")

        response = self._request({
            "action": "call",
            "tool_name": tool_name,
            "arguments": arguments,
        })
        return response.get("content", "")

    def _stop(self):
        process = self.process
        self.process = None

        if process is None:
            return

        try:
            if process.poll() is None:
                process.stdin.close()
                process.terminate()
                process.wait(timeout=5)
        except Exception:
            try:
                process.kill()
            except Exception:
                pass

    def shutdown(self):
        with self.lock:
            self._stop()


personal_outlook = PersonalOutlookBridge()


def personal_outlook_action(parameters=None, **kwargs):
    args = parameters if isinstance(parameters, dict) else {}
    action = str(args.get("action", "")).strip().lower()

    try:
        if action == "list_tools":
            return personal_outlook.list_tools()

        if action == "call":
            tool_name = str(args.get("tool_name", "")).strip()

            if not tool_name:
                return "Please provide tool_name."

            arguments = args.get("arguments", {})
            return personal_outlook.call_tool(
                tool_name,
                arguments,
            )

        return "Unknown action. Use list_tools or call."

    except Exception as exc:
        return (
            f"Personal Outlook error: "
            f"{type(exc).__name__}: {exc}"
        )


atexit.register(personal_outlook.shutdown)
