from outlook.services.graph_client import GraphClient


class EmailService:

    def __init__(self, graph_client: GraphClient):
        self.graph = graph_client

    def _format_email(self, item):
        sender = item.get("from", {}).get("emailAddress", {})

        return {
            "id": item.get("id"),
            "conversation_id": item.get("conversationId"),
            "sent_at": item.get("sentDateTime"),
            "to_recipients": [
                recipient.get("emailAddress", {}).get("address")
                for recipient in item.get("toRecipients", [])
                if recipient.get("emailAddress", {}).get("address")
            ],
            "subject": item.get("subject") or "(No subject)",
            "sender_name": sender.get("name"),
            "sender_email": sender.get("address"),
            "received_at": item.get("receivedDateTime"),
            "is_read": item.get("isRead"),
            "importance": item.get("importance"),
            "preview": item.get("bodyPreview"),
            "body": item.get("body", {}).get("content", ""),
            "body_type": item.get("body", {}).get("contentType"),
            "has_attachments": item.get("hasAttachments", False)
        }


    def get_recent_sent_emails(self, limit=20):
        response = self.graph.get_recent_sent_emails(limit)
        return [
            self._format_email(item)
            for item in response.get("value", [])
        ]

    def get_latest_emails(self, limit=10):
        response = self.graph.get_recent_emails(limit)
        return [
            self._format_email(item)
            for item in response.get("value", [])
        ]

    def get_unread_emails(self, limit=20):
        response = self.graph.get(
            "me/messages",
            params={
                "$filter": "isRead eq false",
                "$top": limit,
                "$orderby": "receivedDateTime desc",
                "$select": (
                    "id,subject,from,receivedDateTime,"
                    "isRead,bodyPreview,importance"
                )
            }
        )

        return [
            self._format_email(item)
            for item in response.get("value", [])
        ]

    def get_email(self, message_id):
        response = self.graph.get(f"me/messages/{message_id}")
        return self._format_email(response)

    def search_emails(self, search_text, limit=20):
        if not search_text or not search_text.strip():
            raise ValueError("Search text cannot be empty.")

        response = self.graph.get(
            "me/messages",
            params={
                "$search": f'"{search_text.strip()}"',
                "$top": limit,
                "$select": (
                    "id,subject,from,receivedDateTime,"
                    "isRead,bodyPreview"
                )
            },
            extra_headers={"ConsistencyLevel": "eventual"}
        )

        return [
            self._format_email(item)
            for item in response.get("value", [])
        ]

    def mark_as_read(self, message_id):
        return self.graph.patch(
            f"me/messages/{message_id}", {"isRead": True}
        )

    def mark_as_unread(self, message_id):
        return self.graph.patch(
            f"me/messages/{message_id}", {"isRead": False}
        )

    def flag_email(self, message_id):
        return self.graph.patch(
            f"me/messages/{message_id}",
            {"flag": {"flagStatus": "flagged"}}
        )

    def unflag_email(self, message_id):
        return self.graph.patch(
            f"me/messages/{message_id}",
            {"flag": {"flagStatus": "notFlagged"}}
        )

    def delete_email(self, message_id):
        return self.graph.delete(f"me/messages/{message_id}")

    def archive_email(self, message_id):
        return self.graph.post(
            f"me/messages/{message_id}/move",
            {"destinationId": "archive"}
        )

    def move_email(self, message_id, destination_folder_id):
        if not message_id or not str(message_id).strip():
            raise ValueError("Message ID is required.")

        if not destination_folder_id or not str(destination_folder_id).strip():
            raise ValueError("Destination folder ID is required.")

        return self.graph.post(
            f"me/messages/{message_id}/move",
            {"destinationId": destination_folder_id}
        )

    def send_email(self, to, subject, body, cc=None, bcc=None):
        if isinstance(to, str):
            to = [to]

        if not to:
            raise ValueError("Recipient is required.")

        message = {
            "subject": subject or "",
            "body": {"contentType": "Text", "content": body},
            "toRecipients": [
                {"emailAddress": {"address": address}}
                for address in to
            ]
        }

        if cc:
            if isinstance(cc, str):
                cc = [cc]
            message["ccRecipients"] = [
                {"emailAddress": {"address": address}}
                for address in cc
            ]

        if bcc:
            if isinstance(bcc, str):
                bcc = [bcc]
            message["bccRecipients"] = [
                {"emailAddress": {"address": address}}
                for address in bcc
            ]

        return self.graph.post(
            "me/sendMail",
            {"message": message, "saveToSentItems": True}
        )

    def reply_email(self, message_id, comment):
        return self.graph.post(
            f"me/messages/{message_id}/reply",
            {"comment": comment}
        )

    def forward_email(self, message_id, to, comment=""):
        if isinstance(to, str):
            to = [to]

        recipients = [
            {"emailAddress": {"address": address}}
            for address in to
        ]

        return self.graph.post(
            f"me/messages/{message_id}/forward",
            {"comment": comment, "toRecipients": recipients}
        )
